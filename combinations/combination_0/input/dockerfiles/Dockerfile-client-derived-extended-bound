FROM rubeneschauzier/comunica-query-sparql-link-traversal-solid-derived-resources:dev

ARG CONFIG_CLIENT
ARG QUERY_TIMEOUT
ARG MAX_MEMORY
ARG LOG_LEVEL

ADD $CONFIG_CLIENT /tmp/config.json

ENV COMUNICA_CONFIG=/tmp/config.json
ENV NODE_ENV=production
ENV MAX_MEMORY=$MAX_MEMORY
ENV QUERY_TIMEOUT=$QUERY_TIMEOUT
ENV LOG_LEVEL=$LOG_LEVEL

# Extended blocks (sent as the star and the star with its hops) and bound composites seeded by one-shot constants
ENV DERIVED_EXTEND_BLOCKS=1
ENV DERIVED_BOUND_COMPOSITES=1

EXPOSE 3000

ENTRYPOINT []
CMD [ "/bin/sh", "-c", "node --max-old-space-size=$MAX_MEMORY ./bin/http.js -c /tmp/context.json -p 3000 -t $QUERY_TIMEOUT -l $LOG_LEVEL -i --idp void --lenient --contextOverride" ]
